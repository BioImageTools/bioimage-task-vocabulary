        edam:operation_Image_registration,
        edam:operation_Image_segmentation,
        edam:operation_Image_stitching,
        edam:operation_Image_tracking,
        edam:operation_Montage,
        edam:operation_Morphological_operations,
        edam:operation_Pixel_classification,
        edam:operation_Projection,
        edam:operation_Skeletonization,
        edam:operation_Spot_extraction,
        edam:operation_Watershed,
        edam:operation__R7MFwdgojfmkZ07yWbdcda0,
        edam:operation__R9Qf06vxvFj2UbAk7pW3IMG,
        edam:operation__Rhb4iyLUQWY4HnhPpuqNNI,
